<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
                      http://maven.apache.org/xsd/settings-1.0.0.xsd">
    <!-- Align with pom.xml / ci.yml: GITHUB_PACKAGES_USERNAME + GITHUB_PACKAGES_TOKEN.
         Laptop alternatives: set those, or set GITHUB_ACTOR + GITHUB_TOKEN and use mvn.cmd
         (maps either direction). Central Contabo publish writes its own ~/.m2/settings.xml. -->
    <servers>
        <server>
            <id>github</id>
            <username>${env.GITHUB_PACKAGES_USERNAME}</username>
            <password>${env.GITHUB_PACKAGES_TOKEN}</password>
        </server>
        <server>
            <id>github-investment</id>
            <username>${env.GITHUB_PACKAGES_USERNAME}</username>
            <password>${env.GITHUB_PACKAGES_TOKEN}</password>
        </server>
        <server>
            <id>github-am-common</id>
            <username>${env.GITHUB_PACKAGES_USERNAME}</username>
            <password>${env.GITHUB_PACKAGES_TOKEN}</password>
        </server>
        <server>
            <id>github-core</id>
            <username>${env.GITHUB_PACKAGES_USERNAME}</username>
            <password>${env.GITHUB_PACKAGES_TOKEN}</password>
        </server>
        <server>
            <id>github-trade</id>
            <username>${env.GITHUB_PACKAGES_USERNAME}</username>
            <password>${env.GITHUB_PACKAGES_TOKEN}</password>
        </server>
    </servers>
</settings>
